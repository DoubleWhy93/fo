 "source_quotes": [
  {
   "q": "法數一般包括兩部分：核心數和微細數。核心數代表根本智，微細數代表差別行法。經文中法數的呈現有兩種形式：一種是直接給出數字，一種是間接給出數字。",
   "src": "pages/huayan28/28jiang11"
  },
  {
   "q": "我們介紹過三十二、二十一、四十二、二十五、六十二，這些都是法數。",
   "src": "pages/swxf/shizhu5"
  },
  {
   "q": "『二十一』是法數，是指以『二十法』入『一法』，總合在一起即『二十一法』",
   "src": "pages/huayan70/jiangyi46"
  }
 ],
